# ===================================================
# MEDISHOP BACKEND ENVIRONMENT VARIABLES (RENDER / PROD)
# ===================================================
# Copy these variables into Render Web Service -> Environment Variables

# 1. Server Configuration
PORT=5000
NODE_ENV=production
# Frontend URL(s) on Vercel (comma-separated if multiple domains)
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:3000

# 2. MongoDB Database Connection (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medishop?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medishop?retryWrites=true&w=majority

# 3. Redis Configuration (Upstash / Redis Cloud)
REDIS_HOST=becoming-ox-210223.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=gQAAAAAAAzUvAAIgcDJjYTMwNTQ3OGE4YWI0OGFiYWQzMzQxYjEzMzNiOTMwMg

# 4. JWT Authentication Secrets & Expiry (Generate strong 64-char random strings for production)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# 5. OTP & Verification Settings (Set false for live SMS/Email in production)
ENABLE_DEMO_OTP=true

# 6. Cloudinary Media Asset Storage
CLOUDINARY_CLOUD_NAME=dml8dj0tu
CLOUDINARY_API_KEY=153474899812477
CLOUDINARY_API_SECRET=Q9qqZPtb9aYC1E-7tLNWzL7bTeo

# 7. SMTP Mail Configuration (Gmail / SendGrid / Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=emamjion0@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="mediShop" <emamjion0@gmail.com>
