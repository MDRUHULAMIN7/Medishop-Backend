# Server Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGO_URI=mongodb://127.0.0.1:27017/medishop

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=medishop_access_secret_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=medishop_refresh_secret_key_change_in_production_32chars
JWT_REFRESH_EXPIRES_IN=7d

# Auth & OTP Settings
ENABLE_DEMO_OTP=true

# Courier Provider
COURIER_PROVIDER=mock
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_TOKEN_PATH=/oauth/token
PATHAO_QUOTE_PATH=/delivery-fees/quote
PATHAO_SHIPMENT_PATH=/shipments
PATHAO_TRACKING_PATH=/shipments/:trackingNumber
PATHAO_CANCEL_PATH=/shipments/:trackingNumber/cancel
PATHAO_PICKUP_PATH=/pickups

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# Mail / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=demo
SMTP_PASS=demo
SMTP_FROM=no-reply@medishop.com
