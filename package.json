    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "vitest": "^2.0.2"
  }
