{
  "name": "medishop-backend",
  "version": "1.0.0",
  "description": "Production-grade feature-based modular monolith backend for mediShop online pharmacy platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "recognition:embeddings": "ts-node-dev --transpile-only scripts/generate-product-embeddings.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "medishop",
    "express",
    "typescript",
    "mongodb",
    "redis",
    "swagger",
    "pharmacy"
  ],
  "author": "mediShop Team",
  "license": "ISC",
